# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Generated in the local Langfuse UI (http://localhost:3001) after first boot:
# docker compose -f docker-compose.dev.yml up -d  →  create org/project → API keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# SEC EDGAR requires a declared identity (name + email) in the user agent.
EDGAR_IDENTITY="Firstname Lastname email@example.com"

# Phase 3 retrieval: Voyage serves embeddings (voyage-finance-2) and the
# rerank-2.5 reranker; OpenAI only for the embedding benchmark baseline.
VOYAGE_API_KEY=pa-...
OPENAI_API_KEY=sk-proj-...

# Optional overrides (defaults: voyage / voyage). Useful while Voyage billing
# is not enabled — trial rate limits (3 RPM / 10K TPM) block corpus-scale use.
# EMBEDDING_PROVIDER=openai
# RERANKER_PROVIDER=none

# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Generated in the local Langfuse UI (http://localhost:3000) after first boot:
# docker compose -f docker-compose.dev.yml up -d  →  create org/project → API keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# SEC EDGAR requires a declared identity (name + email) in the user agent.
EDGAR_IDENTITY="Firstname Lastname email@example.com"

# Copy to .env and fill in. Never commit .env.

# Required to answer a question: every production role routes through
# OpenRouter (ADR 0014).
OPENROUTER_API_KEY=

# Required to ingest: production embeds with text-embedding-3-small (ADR 0011).
OPENAI_API_KEY=

# Required to ingest. SEC EDGAR requires a declared identity (a real name and
# email) in the user agent, and refuses noreply addresses.
EDGAR_IDENTITY=

# Only for `eval-agent`: the citation judge runs on Anthropic directly.
ANTHROPIC_API_KEY=

# Optional. Without these, tracing is off and everything else works. With the
# local stack (`make langfuse-up`), create an org and project at
# http://localhost:3001 and copy its API keys here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Only for the retrieval benchmark's Voyage arms (`eval-retrieval`). Production
# uses neither Voyage embeddings nor its reranker; ADR 0011 measured both.
VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=openai
# RERANKER_PROVIDER=none

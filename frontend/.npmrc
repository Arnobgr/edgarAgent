# Supply-chain defaults for this package. Both lines are policy, not taste.
#
# `ignore-scripts` is the load-bearing one: a compromised package's
# install/postinstall hook is the cheapest way to run code on a developer's
# machine or a CI runner, and it fires on a plain `npm install` before
# anything is ever imported. Cost: esbuild's postinstall no longer links its
# native binary, so a fresh install needs one deliberate `npm rebuild esbuild`
# rather than a blanket exemption.
ignore-scripts=true

# Never resolve a version published in the last fortnight. A malicious release
# of an otherwise legitimate package is normally caught and yanked within
# days, so waiting the window out is worth more here than being current — this
# is a demo frontend, nothing in it needs a release from this week. Bump the
# date deliberately when a dependency has to move; the committed lockfile is
# what actually pins the tree between bumps.
before=2026-07-23
